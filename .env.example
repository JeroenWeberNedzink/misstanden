# Frontend-safe variables (exposed to browser by Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# Optional server-side alias used by PHP APIs (falls back to VITE_AUTH0_DOMAIN)
AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_spa_client_id
# Required for API access-token flows (no fallback to https://<domain>/mfa/)
VITE_AUTH0_AUDIENCE=https://your-api-identifier
VITE_AUTH0_API_SCOPE=read:admin_api write:admin_api run:sla_backfill
VITE_ENABLE_SMS_FEATURE=false
# Optional startup guard for nz-startup.ps1 (true = hard fail when audience is missing)
NZ_REQUIRE_AUTH0_AUDIENCE=false

# Server-side only secrets (never prefix with VITE_)
AUTH0_CLIENT_SECRET=your_server_only_auth0_client_secret
AUTH0_MGMT_CLIENT_ID=your_auth0_m2m_client_id
AUTH0_MGMT_CLIENT_SECRET=your_auth0_m2m_client_secret
AUTH0_MGMT_AUDIENCE=https://your-tenant.auth0.com/api/v2/
# Required Management API permissions for email verification endpoint:
# read:users, update:users, create:jobs
# Optional static fallback (not recommended for production)
AUTH0_MGMT_API_TOKEN=
SUPABASE_DB_PASSWORD=your_server_only_db_password
SUPABASE_SERVICE_ROLE_KEY=your_server_only_supabase_service_role_key
SLA_BACKFILL_CRON_KEY=generate_a_long_random_secret

# Mail/API environment
PHP_MAIL_API_URL=http://localhost:8081/api/mail.api.php
MAIL_DEV_SINK=false
SMTP_HOST=
SMTP_PORT=25
SMTP_AUTH=false
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
