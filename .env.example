# Frontend-safe variables (exposed to browser by Vite)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# Optional server-side alias used by PHP APIs (falls back to VITE_AUTH0_DOMAIN)
AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_spa_client_id
# Required for API access-token flows (no fallback to https://<domain>/mfa/)
VITE_AUTH0_AUDIENCE=https://your-api-identifier
VITE_AUTH0_API_SCOPE=read:admin_api write:admin_api run:sla_backfill
VITE_ENABLE_SMS_FEATURE=false
VITE_SUPER_ADMIN_EMAILS=admin@example.com
VITE_SUPER_ADMIN_SUBS=auth0|replace-with-user-id
# Optional startup guard for nz-startup.ps1 (true = hard fail when audience is missing)
NZ_REQUIRE_AUTH0_AUDIENCE=false

# Server-side only secrets (never prefix with VITE_)
AUTH0_CLIENT_SECRET=your_server_only_auth0_client_secret
AUTH0_MGMT_CLIENT_ID=your_auth0_m2m_client_id
AUTH0_MGMT_CLIENT_SECRET=your_auth0_m2m_client_secret
AUTH0_MGMT_AUDIENCE=https://your-tenant.auth0.com/api/v2/
# Required Management API permissions for email verification endpoint:
# read:users, update:users, create:jobs
# Optional static fallback (not recommended for production)
AUTH0_MGMT_API_TOKEN=

# Optional but recommended for .\nz-startup.ps1 local pipeline tests.
# Create/use a Machine-to-Machine app authorized for VITE_AUTH0_AUDIENCE,
# then place its client id/secret here. Do not use the Single Page Application.
AUTH0_API_TEST_CLIENT_ID=your_auth0_m2m_test_client_id
AUTH0_API_TEST_CLIENT_SECRET=your_auth0_m2m_test_client_secret
# Optional override. Defaults to VITE_AUTH0_API_SCOPE.
API_TEST_AUTH_SCOPE=read:admin_api write:admin_api run:sla_backfill

SLA_BACKFILL_CRON_KEY=generate_a_long_random_secret

# SQL Server migration target
SQLSERVER_HOST=192.168.167.25
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=MisstandenPortaal
SQLSERVER_USERNAME=MisstandenPortaal
SQLSERVER_PASSWORD=your_sql_server_password
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_LOGIN_TIMEOUT=5
SQLSERVER_COMMAND_TIMEOUT=30

# Mail/API environment
PORTAL_BASE_URL=https://misstanden.example.com
PHP_MAIL_API_URL=http://localhost:8081/api/mail.api.php
MAIL_DEV_SINK=false
SMTP_HOST=
SMTP_PORT=25
SMTP_AUTH=false
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Scheduled reporter-reminder endpoint (use the same protected scheduled-task pattern as SLA jobs).
REPORTER_REMINDER_CRON_KEY=
# Required server-only secret (at least 32 characters) for attachment token encryption/signing.
ATTACHMENT_TOKEN_KEY=
# Required server-only secret (at least 32 characters) for reporter access-code and reply-token hashes.
PORTAL_TOKEN_HASH_KEY=
ATTACHMENT_SIGNED_URL_TTL=600
# Optional absolute path outside the IIS web root; defaults to private/uploads.
ATTACHMENT_STORAGE_ROOT=
REPORTER_FOLLOW_UP_DELAY_HOURS=24
REPORTER_UNASSIGNED_DELAY_HOURS=72
REPORTER_REMINDER_MIN_GAP_HOURS=24
REPORTER_REMINDER_RETRY_HOURS=6
