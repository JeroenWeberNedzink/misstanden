# Frontend-safe variables (exposed to browser by Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_spa_client_id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
VITE_AUTH0_API_SCOPE=read:admin_api write:admin_api run:sla_backfill
VITE_ENABLE_SMS_FEATURE=false

# Server-side only secrets (never prefix with VITE_)
AUTH0_CLIENT_SECRET=your_server_only_auth0_client_secret
SUPABASE_DB_PASSWORD=your_server_only_db_password
SUPABASE_SERVICE_ROLE_KEY=your_server_only_supabase_service_role_key

# Mail/API environment
PHP_MAIL_API_URL=http://localhost:8081/api/mail.api.php
MAIL_DEV_SINK=false
SMTP_HOST=
SMTP_PORT=25
SMTP_AUTH=false
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
