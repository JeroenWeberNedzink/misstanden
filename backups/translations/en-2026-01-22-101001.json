            "keyFeatures": "Key Features",
            "netherlands": {
                "lawTitle": "Whistleblower Protection Act (2023)",
                "lawDescription": "In force since February 18, 2023, implements EU Directive 2019/1937",
                "protections": [
                    "Protection against retaliation and dismissal",
                    "Confidentiality of identity guaranteed",
                    "Right to legal assistance",
                    "Compensation for reprisals"
                ],
                "features": [
                    "Direct external reporting allowed",
                    "Acknowledgment within 7 days",
                    "Investigation started within 2 weeks",
                    "Position within 8-12 weeks"
                ]
            },
            "belgium": {
                "lawTitle": "Whistleblower Protection Act (2023)",
                "lawDescription": "Implements EU Directive 2019/1937 for whistleblower protection",
                "protections": [
                    "Strong emphasis on confidentiality",
                    "Protection against reprisals",
                    "Anonymity permitted",
                    "Legal support available"
                ],
                "features": [
                    "Federal Ombudsman as external channel",
                    "Secure app for anonymous reports",
                    "SIOD as competent supervisor",
                    "No obligation for anonymous facilitation"
                ]
            },
            "germany": {
                "lawTitle": "Whistleblower Protection Act (HinSchG, 2023)",
                "lawDescription": "In force since July 2023, implements EU directive for whistleblower protection",
                "protections": [
                    "Protection against retaliation",
                    "Strict data storage rules",
                    "Data minimization required",
                    "Confidentiality guaranteed"
                ],
                "features": [
                    "Federal Office of Justice as external channel",
                    "Anonymous reports allowed",
                    "Online form available",
                    "No mandatory anonymous system"
                ]
            },
            "france": {
                "lawTitle": "Sapin II Law (amended 2022)",
                "lawDescription": "Amended in 2022 to implement EU Directive 2019/1937",
                "protections": [
                    "Protection for interns and freelancers",
                    "Right to press freedom if no effect",
                    "Mandatory processing of anonymous reports",
                    "Broad definition of protected persons"
                ],
                "features": [
                    "Multiple competent authorities (AFA, ANSSI, etc.)",
                    "Anonymous reports must be processed",
                    "Direct press access possible",
                    "Suppliers explicitly protected"
                ]
            }
        },
