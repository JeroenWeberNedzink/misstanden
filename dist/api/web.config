<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Enable PHP handler for this directory -->
    <handlers>
      <add name="PHP-FastCGI" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\Program Files\PHP\v8.2\php-cgi.exe" resourceType="Either" requireAccess="Script" />
    </handlers>

    <!-- Default document -->
    <defaultDocument>
      <files>
        <clear />
        <add value="mail.api.php" />
      </files>
    </defaultDocument>

    <!-- CORS headers for API -->
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization" />
      </customHeaders>
    </httpProtocol>

    <!-- Security settings -->
    <security>
      <requestFiltering>
        <!-- Allow large file uploads for attachments (50MB) -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- Static content MIME types -->
    <staticContent>
      <mimeMap fileExtension=".php" mimeType="application/x-httpd-php" />
    </staticContent>

    <!-- Error handling -->
    <httpErrors errorMode="Detailed" />
  </system.webServer>

  <!-- PHP Settings -->
  <system.web>
    <compilation debug="false" />
  </system.web>
</configuration>
